---
// <head> of every page: meta tags, structured data (JSON-LD), fonts, global styles and scripts.
import '../styles/global.css';

interface Props {
  lang: string;
  /** Open Graph locale, e.g. en_US */
  locale: string;
  title: string;
  description: string;
  /** Path of this page, e.g. "/" or "/ru/portfolio/phoenix-jacket/" */
  path: string;
  /** All language versions of this page, for hreflang */
  alternates?: { lang: string; path: string }[];
  /** Structured data blocks (each becomes its own <script type="application/ld+json">) */
  jsonLd?: Record<string, unknown>[];
  /** Link preview image (absolute path on the site); defaults to the site card */
  ogImage?: { src: string; width: number; height: number };
}
const { lang, locale, title, description, path, alternates = [], jsonLd = [], ogImage = { src: '/og-image.png', width: 1200, height: 630 } } = Astro.props;
const url = new URL(path, Astro.site);
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.path, Astro.site)} />)}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={url} />
  <meta property="og:site_name" content="Phygital Fashion Lab" />
  <meta property="og:locale" content={locale} />
  <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
  <meta property="og:image:width" content={String(ogImage.width)} />
  <meta property="og:image:height" content={String(ogImage.height)} />
  <meta property="og:image:alt" content={title} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/icon.svg" type="image/svg+xml" />
  <link rel="icon" href="/icon-48.png" type="image/png" sizes="48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block, null, 2)} />)}
</head>
<body>
  <slot />
  <script>
    import { initUi } from '../scripts/ui.js';
    import { initStitches } from '../scripts/stitch.js';
    initUi();
    initStitches();
  </script>
</body>
</html>

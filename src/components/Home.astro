---
// Home and its deep-linked sections use the shared editorial layout.
import Editorial from './editorial/Editorial.astro';
import Base from '../layouts/Base.astro';
import type { Copy } from '../content/types';

interface Props { t: Copy; path: string; alternates?: { lang: string; path: string }[] }
const { t, path, alternates } = Astro.props;
const lang = t.lang === 'ru' ? 'ru' : 'en';
// FAQ as structured data: the same questions and answers that are on the page
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a.join(' ') },
  })),
};
---
<Base editorial lang={t.lang} locale={t.locale} title={t.meta.title} description={t.meta.description} path={path} alternates={alternates} jsonLd={[t.jsonLd, faqLd]}>
  <Editorial lang={lang} screen="home" alternatePath={lang === 'ru' ? '/' : '/ru/'} />
</Base>

---
// The portfolio shares the site layout and retains its own metadata and translated address.
import Editorial from '../editorial/Editorial.astro';
import Base from '../../layouts/Base.astro';
import { caseUi } from '../../portfolio';

interface Props { lang: 'en' | 'ru' }
const { lang } = Astro.props;
const ui = caseUi[lang];
const other = lang === 'ru' ? 'en' : 'ru';
const alternates = [{ lang: 'en', path: '/portfolio/' }, { lang: 'ru', path: '/ru/portfolio/' }, { lang: 'x-default', path: '/portfolio/' }];
---
<Base editorial lang={ui.lang} locale={ui.locale} title={ui.portfolioTitle} description={ui.portfolioDescription} path={ui.portfolioPath} alternates={alternates}>
  <Editorial lang={lang} screen="portfolio" alternatePath={caseUi[other].portfolioPath} />
</Base>

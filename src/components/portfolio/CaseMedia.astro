---
// One picture or video inside a case. Pictures open large on click; external players load after a click.
import { Picture, getImage } from 'astro:assets';
import type { MediaRef } from '../../portfolio/types';
interface Props { m: MediaRef; sizes?: string; eager?: boolean }
const { m, sizes = '(max-width: 1040px) calc(100vw - 40px), 980px', eager = false } = Astro.props;
const full = m.kind === 'image' ? (await getImage({ src: m.img, width: Math.min(m.img.width, 3000), format: 'webp' })).src : '';
---
{m.kind === 'image' && (
  <Picture src={m.img} alt={m.alt} formats={['webp']} widths={[...new Set([480, 800, 1200, 1600, 2400].filter((w) => w < m.img.width).concat(Math.min(m.img.width, 3000)))]} sizes={sizes} class="shot" data-full={full} loading={eager ? 'eager' : 'lazy'} decoding="async" />
)}
{m.kind === 'video' && !m.autoplay && (
  <video class="clip" style={`--r: ${m.ratio}`} controls preload="none" playsinline loop={m.loop} src={m.src} poster={m.poster} aria-label={m.label}></video>
)}
{m.kind === 'video' && m.autoplay && (
  <!-- Short silent animation that plays by itself like a GIF (the only exception to "no autoplay"); paused for reduced motion -->
  <video class="clip anim" style={`--r: ${m.ratio}`} autoplay muted loop playsinline preload="auto" src={m.src} poster={m.poster} aria-label={m.label}></video>
)}
{m.kind === 'model' && (
  <div class="model" style={`--r: ${m.ratio}${m.bg ? `; --model-bg: ${m.bg}` : ''}`} data-src={m.src} data-title={m.label}>
    {m.poster && <img src={m.poster} alt="" loading="lazy" decoding="async" />}
    <button type="button" class="embed-play"><span aria-hidden="true">⟳</span> {m.play}<span class="sr">: {m.label}</span></button>
  </div>
)}
{m.kind === 'embed' && (
  <div class="embed" style={`--r: ${m.ratio}`} data-src={m.src} data-title={m.label}>
    <button type="button" class="embed-play"><span aria-hidden="true">▶</span> {m.play}<span class="sr">: {m.label}</span></button>
  </div>
)}

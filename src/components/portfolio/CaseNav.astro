---
// The buttons on every project page: back to the portfolio and to the main site (the portfolio page itself hides the first one).
import type { CaseUi } from '../../portfolio/types';
interface Props { ui: CaseUi; showAll?: boolean }
const { ui, showAll = true } = Astro.props;
---
<nav class="case-nav" aria-label={ui.lang === 'ru' ? 'Навигация' : 'Navigation'}>
  {showAll && <a class="pill" href={ui.portfolioPath}>← {ui.allProjects}</a>}
  <a class="pill" href={ui.homePath}>{ui.home}</a>
</nav>

---
// Page of one portfolio project: navigation → title → cover → the project's own blocks → navigation.
// Each case lists only the blocks it needs (see src/portfolio/types.ts).
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import CaseNav from './CaseNav.astro';
import CaseMedia from './CaseMedia.astro';
import { en } from '../../content/en';
import { ru } from '../../content/ru';
import { site, orgId } from '../../content/jsonld';
import { caseUi, casePath } from '../../portfolio';
import type { Project, CaseCopy, MediaRef } from '../../portfolio/types';
import { getImage } from 'astro:assets';

interface Props { project: Project; lang: 'en' | 'ru' }
const { project, lang } = Astro.props;
const c = project[lang] as CaseCopy;
const ui = caseUi[lang];
const t = lang === 'ru' ? ru : en;
// Width-to-height ratio of a picture or video: side-by-side items get column widths in this proportion, so they share one height
const ratioOf = (m: MediaRef) => (m.kind === 'image' ? m.img.width / m.img.height : m.ratio);
const other = lang === 'ru' ? 'en' : 'ru';
const hasOther = !!project[other];
const path = casePath(lang, project.slug);
const alternates = hasOther
  ? [{ lang: 'en', path: casePath('en', project.slug) }, { lang: 'ru', path: casePath('ru', project.slug) }, { lang: 'x-default', path: casePath('en', project.slug) }]
  : [];

// Every video on the page, for VideoObject structured data
const videos = c.blocks.flatMap((b) => (b.kind === 'steps' ? b.steps.flatMap((st) => (Array.isArray(st.media) ? st.media : [st.media])) : b.kind === 'result' ? b.media : []))
  .filter((m): m is Extract<MediaRef, { kind: 'video' }> => m.kind === 'video');
const coverUrl = new URL((await getImage({ src: c.cover.img, width: Math.min(c.cover.img.width, 1600), format: 'jpg' })).src, site).href;
const pageUrl = new URL(path, site).href;
const ogImage = c.ogImage ? { src: c.ogImage, width: 1200, height: 630 } : undefined;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    '@id': `${pageUrl}#case`,
    name: c.title,
    headline: c.metaTitle,
    description: c.metaDescription,
    inLanguage: lang,
    dateCreated: String(project.year),
    datePublished: project.published,
    url: pageUrl,
    image: coverUrl,
    creator: { '@id': orgId },
    author: { '@type': 'Person', name: en.contact.people[project.provider].name },
    ...(project.client && { mentions: { '@type': 'Organization', name: project.client.name, ...(project.client.url && { url: project.client.url }) } }),
    ...(videos.length && { video: videos.map((v) => ({
      '@type': 'VideoObject',
      name: v.label,
      description: v.label,
      contentUrl: new URL(v.src, site).href,
      ...(v.poster && { thumbnailUrl: new URL(v.poster, site).href }),
      uploadDate: project.published,
      inLanguage: lang,
    })) }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Phygital Fashion Lab', item: new URL(ui.homePath, site).href },
      { '@type': 'ListItem', position: 2, name: c.title, item: pageUrl },
    ],
  },
];
---
---
<Base lang={ui.lang} locale={ui.locale} title={c.metaTitle} description={c.metaDescription} path={path} alternates={alternates} jsonLd={jsonLd} ogImage={ogImage}>
<div class="wrap case-wrap">
  <div class="case-top">
    <CaseNav ui={ui} />
    {hasOther && <p class="lang-switch"><a href={casePath(other, project.slug)} hreflang={ui.langSwitch.lang} lang={ui.langSwitch.lang} aria-label={ui.langSwitch.aria}>{ui.langSwitch.label}</a></p>}
  </div>

  <main class="case">
    <header class="case-head">
      <h1>{c.title}</h1>
      {c.subtitle && <p class="case-subtitle">{c.subtitle}</p>}
      <p class="case-meta">{c.meta}</p>
    </header>

    <figure class="case-cover"><CaseMedia m={{ kind: 'image', ...c.cover }} eager /></figure>

    {c.blocks.map((b) => (
      <section class="case-block">
        {b.kind === 'placeholder' && (
          <div class="case-ph"><span class="case-ph-label">{b.label}</span><span>{b.note}</span></div>
        )}
        {b.kind === 'overview' && (
          <>{b.title && <h2 class="sr">{b.title}</h2>}<dl class="case-overview">{b.items.map((i) => <div><dt>{i.label}</dt><dd>{i.text}</dd></div>)}</dl></>
        )}
        {b.kind === 'steps' && (
          <div class="case-steps">
            {b.title && <h2>{b.title}</h2>}
            {b.intro && <p class="case-intro">{b.intro}</p>}
            {b.steps.map((s) => (
              <figure class="case-step">
                {s.caption && <figcaption>{s.caption}</figcaption>}
                {Array.isArray(s.media)
                  ? <div class:list={['case-pair', { 'is-center': s.layout === 'center' }]} style={`grid-template-columns: ${s.media.map((m) => `minmax(0, ${ratioOf(m).toFixed(3)}fr)`).join(' ')}; --sum: ${s.media.reduce((t, m) => t + ratioOf(m), 0).toFixed(3)}; --n: ${s.media.length}`}>{s.media.map((m) => <div><CaseMedia m={m} sizes="(max-width: 760px) calc(100vw - 40px), 490px" /></div>)}</div>
                  : <CaseMedia m={s.media} />}
              </figure>
            ))}
          </div>
        )}
        {b.kind === 'result' && (
          <div class="case-result">
            {b.title && <h2 class:list={[{ sr: b.hideTitle }]}>{b.title}</h2>}
            {b.caption && (() => {
              const [before, after] = b.link ? b.caption.split(b.link.text) : [b.caption];
              return <p class="case-intro">{before}{b.link && <a href={b.link.href} target="_blank" rel="noopener noreferrer">{b.link.text}<span class="sr">{t.ui.newTab}</span></a>}{after}</p>;
            })()}
            {b.media.map((m) => <figure class="case-step"><CaseMedia m={m} /></figure>)}
          </div>
        )}
        {b.kind === 'cta' && (
          <div class="case-cta"><a class="btn" href={`${ui.homePath}#${b.service}`}>{b.label}</a></div>
        )}
        {b.kind === 'credits' && (
          <dl class="case-credits">{b.lines.map((l) => <div><dt>{l.label}</dt><dd>{l.text}</dd></div>)}</dl>
        )}
      </section>
    ))}
  </main>

  <div class="case-bottom"><CaseNav ui={ui} /></div>
  <footer>{t.footer}</footer>
</div>

<dialog class="lightbox" id="lightbox" aria-label={t.ui.lightbox}>
  <button class="close" type="button" aria-label={t.ui.closeWindow}><Icon name="close" /></button>
  <img alt="" />
</dialog>
</Base>
